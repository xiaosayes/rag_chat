# kiosk_server systemd 单元（web-027）——/etc/systemd/system/kiosk-server.service
# 与 Gradio app.py（:7860）互斥运行：Qdrant 本地嵌入模式文件锁（已实证），
#   同库同时只能一个进程持有。本单元与 ragchat-gradio.service 不应同时 enabled。
[Unit]
Description=Digital human kiosk thin API (RAG/ASR/TTS/OCR)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/data/codes/rag_chat
Environment=PATH=/data/miniconda3/envs/cultural-relics-rag/bin:/usr/local/bin:/usr/bin
# 可选：KIOSK_API_TOKEN=<内网令牌>（设置后前端须经 query 参数携带）
ExecStart=/data/miniconda3/envs/cultural-relics-rag/bin/python -m kiosk_server --host 0.0.0.0 --port 7861
Restart=always
RestartSec=3
# 资源水位：薄层 + 内核缓存 ~1.5GB 内存量级（与 Gradio 进程相当）

[Install]
WantedBy=multi-user.target
