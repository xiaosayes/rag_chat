# 阿里云百炼 API 配置
# 从环境变量读取，或在此文件直接设置
DASHSCOPE_API_KEY=your_api_key_here

# Qdrant 配置（本地开发用）
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Embedding 配置
EMBEDDING_MOD_NAME=text-embedding-v3
EMBEDDING_BATCH_SIZE=10  # 批处理大小（text-embedding-v3 单请求上限 10 条，超限会自动钳制）

# LLM 配置
LLM_MODEL_NAME=qwen-plus
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
# 联网搜索总开关（默认 false 避免误扣费）。
# 开启后按需自动启用：开放类/未知类问题或含时效关键词（最新/最近/展览/门票等）自动联网，
# 纯知识库事实问题不联网。需百炼账号开通联网搜索能力，按次计费（约 0.01~0.03 元/次）。
LLM_ENABLE_SEARCH=false

# Qdrant 配置
QDRANT_MEMORY_MODE=false  # 全内存模式，true=加载到RAM查询最快，重启后需重新构建

# 检索配置
RETRIEVER_TOP_K=10
RERANKER_TOP_K=5
RERANKER_MODEL=qwen3-reranker-4b  # 重排序模型（qwen3-reranker-4b / qwen3-reranker-8b；模型名因账号而异，以百炼控制台模型广场为准）