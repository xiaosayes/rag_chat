# 阿里云百炼 API 配置
# 从环境变量读取，或在此文件直接设置
DASHSCOPE_API_KEY=your_api_key_here

# Qdrant 配置（本地开发用）
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Embedding 配置
# bug-110：已从 text-embedding-v3 升级至 text-embedding-v4（API Key 不变）
EMBEDDING_MODEL_NAME=text-embedding-v4
EMBEDDING_BATCH_SIZE=10  # 批处理大小（单请求上限 10 条，超限会自动钳制）

# LLM 配置
LLM_MODEL_NAME=qwen-plus
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
# 联网搜索总开关（默认 false 避免误扣费）。
# 开启后按需自动启用：开放类/未知类问题或含时效关键词（最新/最近/展览/门票等）自动联网，
# 纯知识库事实问题不联网。需百炼账号开通联网搜索能力，按次计费（约 0.01~0.03 元/次）。
LLM_ENABLE_SEARCH=false

# Qdrant 配置
QDRANT_MEMORY_MODE=false  # 全内存模式，true=加载到RAM查询最快，重启后需重新构建

# 检索配置
RETRIEVER_TOP_K=10
RERANKER_TOP_K=5
RERANKER_MODEL=qwen3-rerank  # 重排序模型（qwen3-reranker-4b / qwen3-reranker-8b；模型名因账号而异，以百炼控制台模型广场为准）
# 意图理解（L1 语义分类 + L2 LLM 兜底，bug-113）
# 分层级联：L0 规则（is_kb_related，零成本）→ L1 向量语义分类（原型相似度）→ L2 LLM 兜底（低置信度时）
INTENT_SEMANTIC_ENABLED=true      # L1 语义意图分类总开关
INTENT_SEMANTIC_THRESHOLD=0.50    # L1 置信度阈值（余弦相似度；低于该值且 L2 开启时走 LLM 兜底）
INTENT_LLM_FALLBACK_ENABLED=true  # L2 LLM 兜底开关（仅 L1 低置信度时调用，按次计费）

# ========== 讯飞语音听写 (ASR) ==========
# 获取：讯飞开放平台 https://www.xfyun.cn → 控制台 → 语音听写 → 创建应用
XFYUN_APP_ID=your_app_id
XFYUN_API_KEY=your_api_key
XFYUN_API_SECRET=your_api_secret
ASR_VAD_EOS=2000        # 静音检测 ms（停顿约 2s 服务端自动结束转写，边说边出字+自动结束）
ASR_MAX_DURATION=30     # 最长录音秒数兜底

# ========== 语音合成 (TTS) ==========
# 一期：cosyvoice-v3-flash 系统音色（默认小男孩，真实 API 确认 voice id 后填入）
# 二期：cosyvoice-v3.5-flash + 自定义真人音色（见 README「二期音色定制」）
# API Key 复用 DASHSCOPE_API_KEY（上方）
TTS_ENABLED=true
TTS_MODEL=cosyvoice-v3-flash
TTS_VOICE=longanyang
TTS_CHUNK_CHARS=1000

# --- 语音助手 persona（web-005；部署可按现场改名，零代码） ---
# 唤醒词，逗号分隔多个；asr_dict.json 的 wake_words 可项目级覆盖
ASR_WAKE_WORDS=你好湘小图
# 唤醒应答语（合成一次缓存复用；改文本会自动重合成缓存）
ASR_WAKE_GREETING=您好，请问有什么可以帮您？
